# Copie este arquivo para ".env" para testar localmente.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Obrigatória: senha para entrar no app (escolha uma senha forte)
APP_PASSWORD=troque-esta-senha

# Opcional: rotas reais e distâncias (OpenRouteService, grátis, sem cartão).
# Sem ela (ou se a cota acabar), usa o OSRM público da FOSSGIS e, em último caso, a estimativa em linha reta.
ORS_API_KEY=
# Opcional: osrm (só OSRM) | ors (só ORS) | estimate (nenhum serviço). Vazio = ORS → OSRM → estimativa.
ROUTE_PROVIDER=

# Opcional: seu e-mail para a busca de endereços do OpenStreetMap (boa prática da política de uso)
GEOCODER_EMAIL=

# Opcional: sincronização entre computador e celular (Supabase, grátis).
# Sem elas, os dados ficam salvos só no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
